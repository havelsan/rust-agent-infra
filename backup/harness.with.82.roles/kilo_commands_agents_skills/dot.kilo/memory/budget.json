   8,
   12,
   13,
   15,
   16,
   17,
   18,
   19,
   20,
   21,
   22,
   23,
   29,
   31,
   32,
   37,
   38,
   39,
   40,
   41,
   47,
   48,
   57,
   71
  ]
 },
 "run": {
  "cmd": "kilo run --agent {agent}",
  "timeout_sec": 1800
 },
 "_notes": "Set context_tokens to your model window in tokens. If you literally have 32 KB (about 8000 tokens), use context_tokens=8192, reserve_output_tokens=1024, max_active_skills=3, max_skills_per_step=2, summary_max_bytes=1200, recall_default_bytes=1200, handoff_max_bytes=800."
}