{
 "context_tokens": 32768,
 "reserve_output_tokens": 4096,
 "split": {
  "core": 0.06,
  "definitions": 0.2,
  "task": 0.12,
  "recall": 0.12,
  "working": 0.5
 },
 "limits": {
  "max_active_agents": 3,
  "max_active_skills": 6,
  "max_active_commands": 20,
  "max_skills_per_step": 3,
  "handoff_max_bytes": 1200,
  "summary_max_bytes": 2400,
  "recall_default_bytes": 2400,
  "remember_max_bytes": 1500,
  "graph_default_bytes": 1200
 },
 "org_dir": "~/.kilo/memory/org",
 "style": {
  "caveman": "full",
  "ponytail": "full"
 },
 "recall_extra_dirs": [
  "summaries"
 ],
 "recall_extra_files": [
  "$SDK_DEV_ENV/reference-projects/COMMON_MISTAKES.md",
  "$SDK_DEV_ENV/reference-projects/PRINCIPLES.md",
  ".kilo/karpathy_skill.md"
 ],
 "topics": {
  "part_bytes": 12000
 },
 "tools": {
  "rtk": "auto",
  "graphify": {
   "graph": "graphify-out/graph.json",
   "query_budget_tokens": 600,
   "auto_build_for": [
    "assess-legacy",
    "recover-domain",
    "refactor-debt",
    "port-module",
    "design-target",
    "capture-behavior"
   ]
  }
 },
