
{
  "$schema": "https://app.kilo.ai/config.json",

  // ONLY this provider is allowed
  "enabled_providers": ["local"],

  // 1. Point the default session to your custom provider and model identifier
  "model": "local//local_model",

  // 2. Define custom providers using the singular "provider" key block
  "provider": {
    "local": {
      "options": {
        "baseURL": "http://localhost:3000/v1",
        "apiKey": "OPENAI_API_KEY"
      },
      "models": {
        "/local_model": {
          "name": "Local Model written in RUST_AGENT_INFRA_MODEL env. variable",
          "limit": {
            "context": 64000,
            "output": 8000
          }
        }
      }
    }
  },

  "instructions": [
    ".kilo/rules/*.md"
  ],
  "agent": {
    "behavior": {
      // Explicitly tells the agent backend to initialize and read from memory on startup
      "autoRecallMemory": true
    }
  },

  "permission": {
    "bash": "allow",
    "fs": "allow",
    "external_directory": {
      "RUST_DEV_ENV/reference-projects/*": "allow"
    }
  },
  "indexing": {
    "enabled": false
  },

  "plugin": [
    "PONYTAIL_MJS"
  ]
}

    
